{
  "name": "bcstats-lockbox-frontend",
  "version": "0.4.0",
  "private": true,
  "description": "",
  "author": "",
  "license": "Apache-2.0",
  "scripts": {
    "build": "vite build",
    "build:dts": "vue-tsc --declaration --emitDeclarationOnly",
    "clean": "rimraf coverage dist",
    "debug": "vite --mode debug",
    "format": "prettier ./src --write",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --no-fix --ignore-path .gitignore",
    "preview": "vite preview",
    "prebuild": "npm run lint",
    "prelint": "npm run typecheck",
    "pretest": "npm run lint",
    "posttest": "node ./lcov-fix.mjs",
    "purge": "rimraf node_modules",
    "rebuild": "npm run clean && npm run build",
    "reinstall": "npm run purge && npm install",
    "serve": "vite",
    "test": "vitest run --coverage",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@bcgov/bc-sans": "^2.1.0",
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3",
    "@vitest/coverage-istanbul": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "axios": "^1.21.1",
    "date-fns": "^4.4.0",
    "filesize": "^11.0.24",
    "material-icons": "^1.13.14",
    "oidc-client-ts": "^3.5.0",
    "pinia": "^4.0.1",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primeflex": "^3.3.1",
    "primeicons": "^8.0.2",
    "primevue": "^5.0.4",
    "qrcode.vue": "^3.11.0",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.45",
    "vue-router": "^5.5.0",
    "yup": "^1.7.1"
  },
  "devDependencies": {
    "@pinia/testing": "^2.0.2",
    "@testing-library/vue": "^8.1.0",
    "@tsconfig/node18": "^18.2.7",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vitest-globals": "^1.6.1",
    "eslint-plugin-vue": "^10.12.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.10.1",
    "rimraf": "^6.1.3",
    "sass": "^1.108.1",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "volar-service-eslint": "^0.0.11",
    "vue-tsc": "^3.3.14"
  }
}
